# Copy this file to .env and fill in the values. DO NOT commit .env.
#
# AUTH_TOKEN: shared secret that aer-feeds will send in
#   `Authorization: Bearer <token>` when calling /v1.
#   Generate a long random value, e.g.:
#     openssl rand -hex 32
#
# TUNNEL_TOKEN: the Cloudflare Tunnel token. Get it from:
#   https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel.
#   See README.md for the full Cloudflare setup steps.

AUTH_TOKEN=replace-with-openssl-rand-hex-32
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
